# Server-only configuration. Never commit a real Gemini API key.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
FIREBASE_PROJECT_ID="gen-lang-client-0835541160"
FIRESTORE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"
LITTLE_MEMORY_BUCKET="YOUR_PRIVATE_STORAGE_BUCKET"

# Optional server tuning (defaults are defined in source).
# PORT=8080
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.7-flash
# GEMINI_ATTEMPT_TIMEOUT_MS=15000
# GEMINI_TOTAL_TIMEOUT_MS=40000
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_ATTEMPT_TIMEOUT_MS=60000

# Public Firebase web configuration, baked into the browser build.
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0835541160"
VITE_FIREBASE_API_KEY="YOUR_PUBLIC_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PRIVATE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIRESTORE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"
